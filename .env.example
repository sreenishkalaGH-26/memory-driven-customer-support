# ---- Hindsight (memory layer) ----
# Local Hindsight API (default):
HINDSIGHT_BASE_URL=http://localhost:8888
# Hindsight Cloud: set the hosted base URL from your Hindsight dashboard and an API key.
# HINDSIGHT_BASE_URL=<your hosted Hindsight URL>
HINDSIGHT_API_KEY=

# Optional: change to start every demo with completely empty memory banks
DEMO_RUN_ID=demo1

# ---- LLM for the support agent ----
# anthropic or openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
